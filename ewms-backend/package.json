{
  "name": "ewms-backend",
  "version": "1.0.0",
  "description": "Electronic Waste Management System – Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "e-waste",
    "recycling",
    "nodejs",
    "express"
  ],
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}