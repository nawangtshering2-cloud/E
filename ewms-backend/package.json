{
  "name": "ewms-backend",
  "version": "1.0.0",
  "description": "Electronic Waste Management System – Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "e-waste",
    "recycling",
    "nodejs",
    "express"
  ],
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "winston": "^3.19.0"
  }
}
